{
  "name": "expand-chemical-groups",
  "version": "1.0.0",
  "description": "Expand a chemical-groups abbreviation such as HAlaGlyOH to an OCL molecule",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "sideEffects": false,
  "workspaces": [
    "dev"
  ],
  "scripts": {
    "build": "npm run tsc && cheminfo-build --entry lib/expandChemicalGroups.js --root ExpandChemicalGroups",
    "check-types": "tsc --noEmit && npm run check-types --workspace=expand-chemical-groups-dev",
    "clean": "rimraf coverage dist lib",
    "dev": "npm run dev --workspace=expand-chemical-groups-dev",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cheminfo/expand-chemical-groups.git"
  },
  "keywords": [
    "peptide",
    "nucleotide",
    "dna",
    "rna",
    "openchemlib",
    "molfile",
    "chemical-groups",
    "abbreviation"
  ],
  "author": "Luc Patiny",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cheminfo/expand-chemical-groups/issues"
  },
  "homepage": "https://github.com/cheminfo/expand-chemical-groups",
  "dependencies": {
    "chemical-groups": "^2.2.4",
    "mf-parser": "^3.9.3",
    "openchemlib": "^9.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@zakodium/tsconfig": "^1.0.5",
    "cheminfo-build": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-config-cheminfo-react": "^20.1.0",
    "eslint-config-cheminfo-typescript": "^22.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
